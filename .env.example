# This is a local development connection string for Docker Compose only.
# Do not put production database URLs or secrets in this file.
# In production, set DATABASE_URL in the hosting provider's environment settings.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/chinese_learning_companion?schema=public"

# Auth.js / NextAuth
# Generate a real local value with: npx auth secret
AUTH_SECRET="replace-with-a-generated-secret"

# Google OAuth credentials from Google Cloud Console.
# Local callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Facebook OAuth credentials from Meta for Developers.
# Local callback URL: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID="replace-with-facebook-app-id"
AUTH_FACEBOOK_SECRET="replace-with-facebook-app-secret"

# Usually optional locally. Set in hosted environments when Auth.js cannot infer the public URL.
AUTH_URL="http://localhost:3000"
